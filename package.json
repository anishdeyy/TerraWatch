{
  "name": "darukaa-earth",
  "version": "1.0.0",
  "private": true,
  "description": "Darukaa.Earth — Geospatial Carbon & Biodiversity Intelligence Platform",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix frontend\" \"python -m uvicorn app.main:app --app-dir backend --reload --port 8000\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "python -m uvicorn app.main:app --app-dir backend --reload --port 8000",
    "build": "npm run build --prefix frontend",
    "lint:frontend": "npm run lint --prefix frontend",
    "lint:backend": "ruff check backend",
    "format": "prettier --write \"frontend/src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"frontend/src/**/*.{ts,tsx,css,json}\"",
    "test:frontend": "npm run test --prefix frontend",
    "test:backend": "pytest backend/tests",
    "prepare": "husky install || true"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5"
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,tsx,css,json}": [
      "prettier --write"
    ],
    "backend/**/*.py": [
      "ruff check --fix"
    ]
  }
}
